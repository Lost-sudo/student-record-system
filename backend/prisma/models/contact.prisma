model ContactInfo {
    id String @id @default(uuid())
    
    studentId String @unique
    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    email String
    phone String?
    addressLine1 String?
    addressLine2 String?
    city String?
    state String?
    postalCode String?
    country String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}